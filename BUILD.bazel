# This header only target strips the __generated__ prefix for the compiler
# search paths, making the location of generated code transparent to the build
cc_library(
    name = "mbgl-core-generated-public-artifacts",
    hdrs = [
               ":generated_shaders",
               ":generated_style_code",
           ] + _PUBLIC_GENERATED_STYLE_HEADERS +
           MLN_GENERATED_SHADER_HEADERS +
           select({
               "//:metal_renderer": [],
               "//conditions:default": MLN_GENERATED_OPENGL_SHADER_HEADERS,
           }),
    visibility = ["//visibility:public"],
)

# ditto, but for private headers (under the src/ path)
cc_library(
    name = "mbgl-core-generated-private-artifacts",
    hdrs = [":generated_style_code"] + _PRIVATE_GENERATED_STYLE_HEADERS,
    visibility = ["//visibility:private"],
)

# Generated source is inserted directly into the core target, no need to remove
# the prefix from the path.
cc_library(
    name = "mbgl-core",
    srcs = if_layer_enabled("plugin", MLN_LAYER_PLUGIN_SOURCE) +
           _CORE_SOURCE +
           MLN_GENERATED_SHADER_SOURCE +
           _GENERATED_STYLE_SOURCE +
           _DRAWABLES_SOURCE + select({
        ":drawable_renderer": MLN_OPENGL_SOURCE + MLN_DRAWABLES_GL_SOURCE,
        ":metal_renderer": MLN_DRAWABLES_MTL_SOURCE,
        ":webgpu_renderer": MLN_DRAWABLES_WEBGPU_SOURCE,
        "//conditions:default": [],
    }) + select({
        "//:harfbuzz_text_shaping": MLN_SHAPING_HARFBUZZ_SRCS,
        "//conditions:default": [],
    }),
    hdrs = if_layer_enabled("plugin", MLN_LAYER_PLUGIN_HEADERS) +
           _CORE_HEADERS +
           MLN_DRAWABLES_HEADERS + select({
        ":drawable_renderer": MLN_OPENGL_HEADERS + MLN_DRAWABLES_GL_HEADERS,
        ":metal_renderer": MLN_DRAWABLES_MTL_HEADERS,
